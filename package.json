{
  "name": "ext-fleurpdf",
  "version": "0.2.1",
  "description": "FleurPDF 移动端手写批注测试版（EXT 实验仓库）",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "annotation",
    "handwriting",
    "mobile"
  ],
  "author": "JC",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  }
}
